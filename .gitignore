# Generated artefacts — published as releases, not committed
data/

# Raw CRSP/Compustat pulls. Licensed data; never commit.
raw/

# Node
node_modules/
site/dist/
site/tsconfig.tsbuildinfo
*.log

# Local convenience symlink to the generated data/ directory. Recreate with:
#   ln -s ../../data site/public/data
site/public/data

# Python
.venv/
__pycache__/
*.pyc

# Licensed identifier overlay (see README)
pipeline/overlays/permno_names.csv

# Machine-local path to the replication package (see pwsite/config.py)
pipeline/.source-path

# Anything dropped in overlays/ is licensed CRSP-derived data. Ignore every data
# file there regardless of what the download happens to be called; only the
# README is tracked.
pipeline/overlays/*
!pipeline/overlays/README.md

.DS_Store
pipeline/doc/*.aux
pipeline/doc/*.log
pipeline/doc/*.out
